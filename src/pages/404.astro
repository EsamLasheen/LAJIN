---
import Layout from "../layouts/Layout.astro";
import { url } from "../utils/url-utils";
---

<Layout title="404 — Signal Lost">
    <div class="lajin-404">
        <canvas id="matrix-canvas" aria-hidden="true"></canvas>
        <div class="lajin-404-content onload-animation">
            <div class="lajin-404-code glitch" data-text="404">404</div>
            <div class="lajin-404-title">// SIGNAL LOST</div>
            <p class="lajin-404-desc">
                The packet you requested never reached its destination.
                It was probably dropped by a firewall, eaten by a router,
                or captured by another CTF player.
            </p>
            <div class="lajin-404-actions">
                <a class="btn-regular lajin-404-btn" href={url("/")}>[ reconnect ]</a>
                <a class="btn-plain lajin-404-btn" href={url("/archive/")}>[ browse archive ]</a>
            </div>
            <div class="lajin-404-hint">trace: no route to host · ttl exceeded · flag&#123;you_found_nothing&#125;</div>
        </div>
    </div>
</Layout>

<style>
    .lajin-404 {
        position: fixed;
        inset: 0;
        z-index: 60;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #050805;
        overflow: hidden;
    }
    #matrix-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0.55;
    }
    .lajin-404-content {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 1.5rem;
        max-width: 36rem;
        font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    }
    .lajin-404-code {
        font-size: clamp(5rem, 18vw, 10rem);
        font-weight: 800;
        line-height: 1;
        color: oklch(0.85 0.2 145);
        text-shadow:
            0 0 12px oklch(0.8 0.25 145 / 0.8),
            0 0 42px oklch(0.7 0.25 145 / 0.5);
    }
    .lajin-404-title {
        margin-top: 0.75rem;
        font-size: 1.05rem;
        letter-spacing: 0.35em;
        color: oklch(0.75 0.14 145);
    }
    .lajin-404-desc {
        margin-top: 1rem;
        color: rgba(255, 255, 255, 0.65);
        font-size: 0.9rem;
        line-height: 1.6;
    }
    .lajin-404-actions {
        margin-top: 1.75rem;
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        flex-wrap: wrap;
    }
    .lajin-404-btn {
        font-family: inherit;
        border-radius: 0.6rem;
        padding: 0.6rem 1.25rem;
        font-weight: 600;
    }
    .lajin-404-hint {
        margin-top: 2.25rem;
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.28);
        overflow-wrap: anywhere;
    }

    /* glitch effect */
    .glitch {
        position: relative;
        display: inline-block;
    }
    .glitch::before,
    .glitch::after {
        content: attr(data-text);
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
    }
    .glitch::before {
        color: oklch(0.85 0.2 25);
        z-index: -1;
        animation: glitch-shift-a 3s infinite steps(1);
    }
    .glitch::after {
        color: oklch(0.8 0.2 220);
        z-index: -2;
        animation: glitch-shift-b 3s infinite steps(1);
    }
    @keyframes glitch-shift-a {
        0%, 88%, 100% { transform: translate(0, 0); clip-path: inset(0 0 0 0); }
        89% { transform: translate(-6px, 2px); clip-path: inset(10% 0 55% 0); }
        91% { transform: translate(5px, -3px); clip-path: inset(60% 0 8% 0); }
        93% { transform: translate(-4px, 1px); clip-path: inset(30% 0 40% 0); }
        95% { transform: translate(0, 0); }
    }
    @keyframes glitch-shift-b {
        0%, 86%, 100% { transform: translate(0, 0); clip-path: inset(0 0 0 0); }
        87% { transform: translate(6px, -2px); clip-path: inset(45% 0 20% 0); }
        90% { transform: translate(-5px, 3px); clip-path: inset(5% 0 70% 0); }
        94% { transform: translate(3px, -1px); clip-path: inset(70% 0 5% 0); }
        96% { transform: translate(0, 0); }
    }
    @media (prefers-reduced-motion: reduce) {
        .glitch::before,
        .glitch::after {
            animation: none;
            opacity: 0;
        }
    }
</style>

<script>
import { startMatrixRain } from "../utils/matrix-rain";
import { unlock } from "../utils/achievements";

unlock("signal-lost");

const canvas = document.getElementById("matrix-canvas") as HTMLCanvasElement | null;
if (canvas && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    startMatrixRain(canvas, { fontSize: 16 });
}
</script>
