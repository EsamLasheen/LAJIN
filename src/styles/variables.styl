/* utils */
white(a)
  rgba(255, 255, 255, a)

black(a)
  rgba(0, 0, 0, a)

rainbow-light = linear-gradient(to right, oklch(0.80 0 0), oklch(0.80 0 0), oklch(0.80 0 0), oklch(0.80 0 0), oklch(0.80 0 0), oklch(0.80 0 0), oklch(0.80 0 0), oklch(0.80 0 0), oklch(0.80 0 0), oklch(0.80 0 0), oklch(0.80 0 0), oklch(0.80 0 0), oklch(0.80 0 0))
rainbow-dark = linear-gradient(to right, oklch(0.70 0 0), oklch(0.70 0 0), oklch(0.70 0 0), oklch(0.70 0 0), oklch(0.70 0 0), oklch(0.70 0 0), oklch(0.70 0 0), oklch(0.70 0 0), oklch(0.70 0 0), oklch(0.70 0 0), oklch(0.70 0 0), oklch(0.70 0 0), oklch(0.70 0 0))

:root
  --radius-large 1rem
  --content-delay 150ms

/* An util to define variables that vary with light and dark mode */
define(vars)
  :root
    for key, value in vars
      {key}: value[0]
  :root.dark
    for key, value in vars
      if length(value) > 1
        {key}: value[1]

define({
  --primary: oklch(0.18 0 0) oklch(0.95 0 0)
  --brand-red: oklch(0.26 0 0) oklch(0.23 0 0)
  --brand-red-deep: oklch(0.17 0 0) oklch(0.13 0 0)
  --accent: oklch(0.98 0 0) oklch(0.96 0 0)
  --danger-accent: oklch(0.58 0 0) oklch(0.70 0 0)
  --page-bg: oklch(0.965 0 0) oklch(0.145 0 0)
  --card-bg: oklch(0.995 0 0) oklch(0.205 0 0)
  --card-border: oklch(0.84 0 0) oklch(0.36 0 0)
  --card-shadow: 0 18px 45px rgba(0, 0, 0, 0.12) 0 20px 60px rgba(0, 0, 0, 0.30)
  --panel-glow: oklch(0.54 0 0 / 0.18) oklch(0.58 0 0 / 0.24)

  --btn-content: oklch(0.36 0 0) oklch(0.96 0 0)

  --btn-regular-bg: oklch(0.95 0 0) oklch(0.28 0 0)
  --btn-regular-bg-hover: oklch(0.90 0 0) oklch(0.34 0 0)
  --btn-regular-bg-active: oklch(0.84 0 0) oklch(0.40 0 0)

  --btn-plain-bg-hover: oklch(0.95 0 0) oklch(0.30 0 0)
  --btn-plain-bg-active: oklch(0.98 0 0) oklch(0.27 0 0)

  --btn-card-bg-hover: oklch(0.98 0 0) oklch(0.3 0 0)
  --btn-card-bg-active: oklch(0.9 0 0) oklch(0.35 0 0)

  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)

  --deep-text: oklch(0.25 0 0)

  --title-active: oklch(0.6 0 0)

  --line-divider: black(0.08) white(0.08)

  --line-color: black(0.1) white(0.1)
  --meta-divider: black(0.2) white(0.2)

  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--btn-content)
  --selection-bg: oklch(0.90 0 0) oklch(0.40 0 0)
  --codeblock-selection: oklch(0.40 0 0)
  --codeblock-bg: oklch(0.17 0 0) oklch(0.17 0 0)
  --codeblock-topbar-bg: oklch(0.3 0 0) oklch(0.12 0 0)

  --license-block-bg: black(0.03) var(--codeblock-bg)

  --link-underline: oklch(0.93 0 0) oklch(0.40 0 0)
  --link-hover: oklch(0.95 0 0) oklch(0.40 0 0)
  --link-active: oklch(0.90 0 0) oklch(0.35 0 0)

  --float-panel-bg: oklch(0.99 0 0) oklch(0.18 0 0)

  --scrollbar-bg-light: black(0.4)
  --scrollbar-bg-hover-light: black(0.5)
  --scrollbar-bg-active-light: black(0.6)

  --scrollbar-bg-dark: white(0.4)
  --scrollbar-bg-hover-dark: white(0.5)
  --scrollbar-bg-active-dark: white(0.6)

  --scrollbar-bg: var(--scrollbar-bg-light) var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light) var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light) var(--scrollbar-bg-active-dark)

  --color-selection-bar: rainbow-light rainbow-dark

  --display-light-icon: 1 0
  --display-dark-icon: 0 1

  --admonitions-color-tip: oklch(0.7 0 0) oklch(0.75 0 0)
  --admonitions-color-note: oklch(0.7 0 0) oklch(0.75 0 0)
  --admonitions-color-important: oklch(0.7 0 0) oklch(0.75 0 0)
  --admonitions-color-warning: oklch(0.7 0 0) oklch(0.75 0 0)
  --admonitions-color-caution: oklch(0.6 0 0) oklch(0.65 0 0)

  --toc-badge-bg: oklch(0.89 0 0) var(--btn-regular-bg)
  --toc-btn-hover: oklch(0.926 0 0) oklch(0.22 0 0)
  --toc-btn-active: oklch(0.90 0 0) oklch(0.25 0 0)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: oklch(0.70 0 0) oklch(0.35 0 0)
})
