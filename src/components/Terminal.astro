---
import { hiddenFlags, profileConfig, siteConfig } from "../config";
import { getSortedPostsList } from "../utils/content-utils";

const posts = (await getSortedPostsList()).map((post) => ({
	slug: post.slug,
	title: post.data.title,
	tags: post.data.tags ?? [],
	category: post.data.category || "",
	description: post.data.description || "",
}));

const validFlags = hiddenFlags.map((f) => f.flag);
const flagPosts = Object.fromEntries(hiddenFlags.map((f) => [f.flag, f.post]));
---

<div id="lajin-shell" class="lajin-shell float-panel-closed" role="dialog" aria-label="LAJIN shell" aria-modal="false">
    <div class="lajin-shell-window">
        <div class="lajin-shell-titlebar">
            <span class="lajin-shell-dot red"></span>
            <span class="lajin-shell-dot yellow"></span>
            <span class="lajin-shell-dot green"></span>
            <span class="lajin-shell-title">esam@lajin: ~/blog</span>
            <button id="lajin-shell-close" class="lajin-shell-close" type="button" aria-label="Close shell">✕</button>
        </div>
        <div id="lajin-shell-output" class="lajin-shell-output" aria-live="polite"></div>
        <form id="lajin-shell-form" class="lajin-shell-inputrow" autocomplete="off">
            <span class="lajin-shell-prompt">➜</span>
            <input
                id="lajin-shell-input"
                class="lajin-shell-input"
                type="text"
                spellcheck="false"
                autocomplete="off"
                aria-label="Shell input"
                placeholder="type `help` to start…"
            />
        </form>
    </div>
    <script is:inline type="application/json" id="lajin-shell-data" set:html={JSON.stringify({ posts, name: profileConfig.name, bio: profileConfig.bio, site: siteConfig.title, validFlags, flagPosts })}></script>
</div>

<style>
    .lajin-shell {
        position: fixed;
        inset: 0;
        z-index: 90;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: oklch(0.08 0 0 / 0.55);
        backdrop-filter: blur(6px);
        transition: opacity 0.18s ease, transform 0.18s ease;
    }
    .lajin-shell.float-panel-closed {
        display: none;
    }
    .lajin-shell-window {
        position: relative;
        width: min(46rem, 100%);
        height: min(30rem, 85vh);
        display: flex;
        flex-direction: column;
        border-radius: 0.9rem;
        overflow: hidden;
        border: 1px solid oklch(0.5 0 0 / 0.5);
        background: oklch(0.14 0 0 / 0.97);
        box-shadow: 0 24px 80px oklch(0 0 0 / 0.55);
        font-family: "JetBrains Mono Variable", ui-monospace, monospace;
    }
    .lajin-shell-titlebar {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.55rem 0.85rem;
        background: oklch(0.2 0 0);
        border-bottom: 1px solid oklch(0.35 0 0 / 0.6);
        user-select: none;
    }
    .lajin-shell-dot {
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 999px;
    }
    .lajin-shell-dot.red { background: #ff5f57; }
    .lajin-shell-dot.yellow { background: #febc2e; }
    .lajin-shell-dot.green { background: #28c840; }
    .lajin-shell-title {
        margin-left: 0.5rem;
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.65);
        letter-spacing: 0.04em;
    }
    .lajin-shell-close {
        margin-left: auto;
        border: none;
        background: transparent;
        color: rgba(255, 255, 255, 0.55);
        cursor: pointer;
        font-size: 0.8rem;
        padding: 0.15rem 0.4rem;
        border-radius: 0.35rem;
    }
    .lajin-shell-close:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.12);
    }
    .lajin-shell-output {
        position: relative;
        flex: 1;
        overflow-y: auto;
        padding: 0.9rem 1rem;
        font-size: 0.82rem;
        line-height: 1.55;
        color: oklch(0.87 0 0);
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }
    .lajin-shell-output :global(a) {
        color: oklch(0.78 0 0);
    }
    .lajin-shell-cmd { color: oklch(0.8 0 0); }
    .lajin-shell-err { color: #ff6b6b; }
    .lajin-shell-dim { color: rgba(255, 255, 255, 0.45); }
    .lajin-shell-accent { color: oklch(0.78 0 0); font-weight: 700; }
    .lajin-shell-rain {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0.35;
    }
    .lajin-shell-output > * {
        position: relative;
        z-index: 1;
    }
    .lajin-shell-inputrow {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.65rem 1rem;
        border-top: 1px solid oklch(0.35 0 0 / 0.6);
        background: oklch(0.17 0 0);
    }
    .lajin-shell-prompt {
        color: oklch(0.78 0 0);
        font-weight: 700;
    }
    .lajin-shell-input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        color: oklch(0.92 0 0);
        font-family: inherit;
        font-size: 0.85rem;
        caret-color: oklch(0.78 0 0);
    }
</style>

<script>
import { startMatrixRain } from "../utils/matrix-rain";
import {
	AUTO_MODE,
	DARK_MODE,
	LIGHT_MODE,
} from "../constants/constants";
import {
	applyThemeToDocument,
	getStoredTheme,
	setTheme,
} from "../utils/setting-utils";
import type { LIGHT_DARK_MODE } from "../types/config";
import { getPostUrlBySlug } from "../utils/url-utils";
import { getUnlockedAchievements, unlock } from "../utils/achievements";

interface ShellPost {
	slug: string;
	title: string;
	tags: string[];
	category: string;
	description: string;
}

interface ShellData {
	posts: ShellPost[];
	name: string;
	bio: string;
	site: string;
	validFlags: string[];
	flagPosts: Record<string, string>;
}

const shell = document.getElementById("lajin-shell");
const output = document.getElementById("lajin-shell-output");
const form = document.getElementById("lajin-shell-form") as HTMLFormElement | null;
const input = document.getElementById("lajin-shell-input") as HTMLInputElement | null;
const closeBtn = document.getElementById("lajin-shell-close");
const dataEl = document.getElementById("lajin-shell-data");

if (shell && output && form && input && closeBtn && dataEl) {
	const data: ShellData = JSON.parse(dataEl.textContent || "{}");
	const posts: ShellPost[] = data.posts ?? [];
	const history: string[] = [];
	let historyIndex = -1;
	let stopRain: (() => void) | null = null;

	// ---- hidden flags -------------------------------------------------
	const FOUND_KEY = "lajin-found-flags";

	function getFoundFlags(): string[] {
		try {
			const raw = localStorage.getItem(FOUND_KEY);
			return raw ? (JSON.parse(raw) as string[]) : [];
		} catch {
			return [];
		}
	}

	function saveFoundFlags(flags: string[]) {
		localStorage.setItem(FOUND_KEY, JSON.stringify(flags));
	}

	function captureFlag(flag: string) {
		const found = getFoundFlags();
		if (found.includes(flag)) return false;
		found.push(flag);
		saveFoundFlags(found);
		unlock("flag-hunter");
		if (data.validFlags && found.length >= data.validFlags.length) {
			unlock("completionist");
		}
		return true;
	}

	// ---- output helpers ------------------------------------------------
	let busy = false;

	const print = (text: string, cls = "") => {
		const line = document.createElement("div");
		if (cls) line.className = cls;
		line.textContent = text;
		output.appendChild(line);
		output.scrollTop = output.scrollHeight;
	};

	const printHTML = (html: string) => {
		const line = document.createElement("div");
		line.innerHTML = html;
		output.appendChild(line);
		output.scrollTop = output.scrollHeight;
	};

	const esc = (s: string) =>
		s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

	const banner = () => {
		print(
			[
				"██╗      █████╗      ██╗███╗   ██╗",
				"██║     ██╔══██╗     ██║████╗  ██║",
				"██║     ███████║ ███ ██║██╔██╗ ██║",
				"██║     ██╔══██║ ╚███╝██║██║╚██╗██║",
				"███████╗██║  ██║  ╚═╝ ██║██║ ╚████║",
				"╚══════╝╚═╝  ╚═╝       ╚═╝╚═╝  ╚═══╝",
			].join("\n"),
			"lajin-shell-cmd",
		);
		print(`${data.site} // offensive field notes`, "lajin-shell-dim");
		print("");
	};

	const help = () => {
		const rows: [string, string][] = [
			["help", "show this panel"],
			["whoami", "who is behind this blog"],
			["ls", "list all writeups"],
			["find <query>", "search titles + tags"],
			["open <n|slug>", "open a writeup"],
			["cat <slug>", "preview a writeup"],
			["nmap <target>", "recon the blog"],
			["run", "run the exploit (trust me)"],
			["cow [msg]", "a wise cow appears"],
			["theme", "cycle light/dark/auto"],
			["matrix", "toggle the digital rain"],
			["flags", "hidden flag progress"],
			["submit <flag>", "capture a hidden flag"],
			["score", "your achievements + flags"],
			["sudo <anything>", "try your luck"],
			["clear", "wipe the output"],
			["exit", "close the shell"],
		];
		for (const [cmd, desc] of rows) {
			printHTML(
				`<span class="lajin-shell-cmd">${esc(cmd.padEnd(16))}</span><span class="lajin-shell-dim">${esc(desc)}</span>`,
			);
		}
	};

	const findPosts = (query: string): ShellPost[] => {
		const q = query.toLowerCase();
		return posts.filter(
			(p) =>
				p.title.toLowerCase().includes(q) ||
				p.slug.toLowerCase().includes(q) ||
				p.category.toLowerCase().includes(q) ||
				p.tags.some((t) => t.toLowerCase().includes(q)),
		);
	};

	const resolvePost = (token: string): ShellPost | undefined => {
		const index = Number.parseInt(token, 10);
		if (!Number.isNaN(index) && String(index) === token.trim()) {
			return posts[index - 1];
		}
		return posts.find((p) => p.slug === token);
	};

	const cycleTheme = () => {
		const seq: LIGHT_DARK_MODE[] = [LIGHT_MODE, DARK_MODE, AUTO_MODE];
		const next = seq[(seq.indexOf(getStoredTheme()) + 1) % seq.length];
		setTheme(next);
		applyThemeToDocument(next);
		print(`theme → ${next}`, "lajin-shell-accent");
	};

	const toggleRain = () => {
		if (stopRain) {
			stopRain();
			stopRain = null;
			print("matrix rain: off", "lajin-shell-dim");
			return;
		}
		let canvas = output.querySelector("#lajin-shell-rain-canvas") as HTMLCanvasElement | null;
		if (!canvas) {
			canvas = document.createElement("canvas");
			canvas.id = "lajin-shell-rain-canvas";
			canvas.className = "lajin-shell-rain";
			output.prepend(canvas);
		}
		stopRain = startMatrixRain(canvas, { fontSize: 14 });
		print("matrix rain: on — follow the white rabbit", "lajin-shell-cmd");
	};

	const openPost = (post: ShellPost) => {
		print(`opening ${post.slug} …`, "lajin-shell-accent");
		window.location.href = getPostUrlBySlug(post.slug);
	};

	const printLater = (delay: number, text: string, cls = "") => {
		window.setTimeout(() => print(text, cls), delay);
	};

	const nmapScan = (target: string) => {
		if (busy) return;
		busy = true;
		const host = target || "lajin.local";
		print(`Starting Nmap 7.95 ( https://nmap.org ) at ${new Date().toLocaleTimeString()}`, "lajin-shell-dim");
		printLater(300, `Scanning ${host} (1000 ports)`, "lajin-shell-dim");
		printLater(700, "PORT     STATE  SERVICE", "");
		printLater(900, "22/tcp   open   ssh", "lajin-shell-cmd");
		printLater(1050, "80/tcp   open   http", "lajin-shell-cmd");
		printLater(1200, "443/tcp  open   https", "lajin-shell-cmd");
		printLater(1400, "1337/tcp open   leet", "lajin-shell-accent");
		printLater(1700, `Nmap done: 1 host up, 0 vulnerabilities — it's a blog, not a target :)`, "lajin-shell-dim");
		printLater(1900, "", "");
		window.setTimeout(() => (busy = false), 2000);
	};

	const runExploit = () => {
		if (busy) return;
		busy = true;
		const steps = [
			"[*] loading exploit modules…",
			"[*] fingerprinting target…",
			"[*] sending payload…",
			"[*] escalating privileges…",
			"[-] Access denied.",
		];
		steps.forEach((s, i) => printLater(280 * i, s, i === steps.length - 1 ? "lajin-shell-err" : "lajin-shell-cmd"));
		printLater(steps.length * 280 + 100, "[!] This blog has no admin panel for you. Nice try though.", "lajin-shell-accent");
		printLater(steps.length * 280 + 250, "", "");
		window.setTimeout(() => (busy = false), steps.length * 280 + 300);
	};

	const cowSay = (msg: string) => {
		const line = msg || "hack responsibly.";
		const border = "-".repeat(line.length + 2);
		print(
			[
				` ${border}`,
				`< ${line} >`,
				` ${border}`,
				"        \\   ^__^",
				"         \\  (oo)\\_______",
				"            (__)\\       )\\/\\",
				"                ||----w |",
				"                ||     ||",
			].join("\n"),
			"lajin-shell-cmd",
		);
	};

	const runCommand = (raw: string) => {
		const cmdline = raw.trim();
		if (!cmdline) return;
		print(`➜ ${cmdline}`, "lajin-shell-dim");

		const [cmd, ...args] = cmdline.split(/\s+/);
		const arg = args.join(" ");

		switch (cmd.toLowerCase()) {
			case "help":
				help();
				break;
			case "banner":
				banner();
				break;
			case "whoami":
				print(`${data.name} — ${data.bio}`, "lajin-shell-accent");
				document.dispatchEvent(new CustomEvent("lajin:whoami"));
				unlock("know-thyself");
				break;
			case "ls": {
				if (posts.length === 0) {
					print("(empty — go write something!)", "lajin-shell-dim");
					break;
				}
				posts.forEach((p, i) => {
					print(`${String(i + 1).padStart(2, " ")}. ${p.slug}  ${p.category ? `[${p.category}]` : ""}`);
				});
				break;
			}
			case "find": {
				if (!arg) {
					print("usage: find <query>", "lajin-shell-err");
					break;
				}
				const hits = findPosts(arg);
				if (hits.length === 0) {
					print(`no matches for "${arg}"`, "lajin-shell-err");
					break;
				}
				hits.forEach((p) => {
					const i = posts.indexOf(p) + 1;
					print(`${i}. ${p.title}`, "lajin-shell-accent");
				});
				break;
			}
			case "cat": {
				const post = resolvePost(arg);
				if (!post) {
					print(`cat: ${arg || "<missing>"}: no such writeup`, "lajin-shell-err");
					break;
				}
				print(post.title, "lajin-shell-accent");
				print(post.description || "(no description)", "lajin-shell-dim");
				print(`tags: ${post.tags.map((t) => `#${t}`).join(" ") || "-"}`, "lajin-shell-dim");
				break;
			}
			case "open": {
				const post = resolvePost(arg);
				if (!post) {
					print(`open: ${arg || "<missing>"}: no such writeup`, "lajin-shell-err");
					break;
				}
				openPost(post);
				break;
			}
			case "theme":
				cycleTheme();
				break;
			case "matrix": {
				const wasOff = !stopRain;
				toggleRain();
				if (wasOff) unlock("digital-rain");
				break;
			}
			case "nmap":
				nmapScan(arg);
				break;
			case "run":
			case "exploit":
				runExploit();
				break;
			case "cow":
				cowSay(arg);
				break;
			case "flags": {
				const found = getFoundFlags();
				const total = data.validFlags?.length ?? 0;
				print(`hidden flags: ${found.length}/${total}`, "lajin-shell-accent");
				for (const flag of data.validFlags ?? []) {
					if (found.includes(flag)) {
						print(`  ${flag}  [captured]`, "lajin-shell-cmd");
					} else {
						const post = data.flagPosts?.[flag];
						print(`  flag{...}?  [hidden — somewhere in ${post ?? "a writeup"}]`, "lajin-shell-dim");
					}
				}
				break;
			}
			case "submit": {
				const match = arg.match(/flag\{[^}]+\}/);
				if (!match) {
					print("usage: submit flag{...}", "lajin-shell-err");
					break;
				}
				if (!(data.validFlags ?? []).includes(match[0])) {
					print("invalid or unknown flag — keep hunting.", "lajin-shell-err");
					break;
				}
				if (getFoundFlags().includes(match[0])) {
					print("already captured — greedy much?", "lajin-shell-dim");
					break;
				}
				captureFlag(match[0]);
				const count = getFoundFlags().length;
				print("*** FLAG ACCEPTED ***", "lajin-shell-cmd");
				print(`${match[0]} captured (${count}/${(data.validFlags ?? []).length})`, "lajin-shell-accent");
				break;
			}
			case "score":
			case "achievements": {
				const achv = getUnlockedAchievements();
				const flags = getFoundFlags();
				print(
					`achievements: ${achv.length}/8   |   flags: ${flags.length}/${(data.validFlags ?? []).length}`,
					"lajin-shell-accent",
				);
				print("full trophy case → /achievements/", "lajin-shell-dim");
				break;
			}
			case "flag":
				print("flag{lajin_shell_pwned_your_heart}", "lajin-shell-cmd");
				break;
			case "sudo":
				print(`[sudo] password for ${data.name.toLowerCase().replace(/\s+/g, "")}: ***`, "lajin-shell-dim");
				print(`${data.name.split(" ")[0]} is not in the sudoers file. This incident will be reported. 🫡`, "lajin-shell-err");
				break;
			case "clear":
				output
					.querySelectorAll("div:not(.lajin-shell-rain)")
					.forEach((el) => el.remove());
				break;
			case "exit":
				closeShell();
				break;
			default:
				print(`command not found: ${cmd} — try \`help\``, "lajin-shell-err");
		}
	};

	const openShell = () => {
		shell.classList.remove("float-panel-closed");
		unlock("first-contact");
		if (output.childElementCount === 0) {
			banner();
			print("Welcome to the LAJIN shell.", "lajin-shell-dim");
			print("Type `help` for commands — hidden flags are out there.", "lajin-shell-dim");
			print("");
		}
		input.focus();
	};

	const closeShell = () => {
		shell.classList.add("float-panel-closed");
		input.blur();
	};

	form.addEventListener("submit", (event) => {
		event.preventDefault();
		const value = input.value;
		if (value.trim()) {
			history.push(value);
		}
		historyIndex = history.length;
		input.value = "";
		runCommand(value);
	});

	input.addEventListener("keydown", (event) => {
		if (event.key === "ArrowUp") {
			if (historyIndex > 0) {
				historyIndex--;
				input.value = history[historyIndex] ?? "";
			}
			event.preventDefault();
		} else if (event.key === "ArrowDown") {
			if (historyIndex < history.length - 1) {
				historyIndex++;
				input.value = history[historyIndex] ?? "";
			} else {
				historyIndex = history.length;
				input.value = "";
			}
			event.preventDefault();
		} else if (event.key === "Tab") {
			event.preventDefault();
			const partial = input.value.toLowerCase();
			if (!partial) return;
			const pool = [
				...["help", "whoami", "ls", "find", "open", "cat", "nmap", "run", "cow", "theme", "matrix", "flags", "submit", "score", "sudo", "clear", "exit", "banner"],
				...posts.map((p) => p.slug),
			];
			const match = pool.find((c) => c.startsWith(partial));
			if (match) input.value = match;
		}
	});

	closeBtn.addEventListener("click", closeShell);

	shell.addEventListener("pointerdown", (event) => {
		if (event.target === shell) closeShell();
	});

	document.addEventListener("keydown", (event) => {
		const isOpen = !shell.classList.contains("float-panel-closed");
		if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
			event.preventDefault();
			if (isOpen) closeShell();
			else openShell();
			return;
		}
		if (isOpen && event.key === "Escape") {
			closeShell();
			return;
		}
		if (
			!isOpen &&
			event.key === "`" &&
			!(event.target instanceof HTMLInputElement) &&
			!(event.target instanceof HTMLTextAreaElement)
		) {
			event.preventDefault();
			openShell();
		}
	});

	document.addEventListener("click", (event) => {
		const target =
			event.target instanceof Element
				? event.target.closest("#lajin-shell-switch, #home-hero-shell-hint")
				: null;
		if (target) {
			event.preventDefault();
			openShell();
		}
	});
}
</script>
