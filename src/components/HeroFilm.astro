---
import { url } from "../utils/url-utils";

const orb = {
	src: url("/videos/identity-02.mp4"),
	poster: url("/videos/identity-02.jpg"),
};
const light = {
	src: url("/videos/identity-03.mp4"),
	poster: url("/videos/identity-03.jpg"),
};
---

<div class="hero-film" aria-hidden="true" data-hero-film>
    <video class="reel ghost-light" src={light.src} poster={light.poster} muted loop playsinline preload="metadata" disablepictureinpicture></video>
    <video class="reel ghost-orb" src={orb.src} poster={orb.poster} muted loop playsinline preload="metadata" disablepictureinpicture></video>
</div>

<style>
    .hero-film {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
        border-radius: inherit;
    }

    .reel {
        position: absolute;
        object-fit: cover;
        mix-blend-mode: screen;
        will-change: transform;
    }

    .ghost-light {
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0.07;
        animation: light-breathe 11s ease-in-out infinite;
    }

    .ghost-orb {
        top: -20%;
        right: 6%;
        width: 40%;
        height: 130%;
        opacity: 0.3;
        -webkit-mask-image: radial-gradient(closest-side, black 40%, transparent 98%);
        mask-image: radial-gradient(closest-side, black 40%, transparent 98%);
        animation: orb-breathe 15s ease-in-out infinite alternate;
    }

    @keyframes light-breathe {
        0%, 100% { opacity: 0.045; }
        50% { opacity: 0.095; }
    }

    @keyframes orb-breathe {
        from { transform: scale(1) rotate(0deg); }
        to { transform: scale(1.08) rotate(2deg); }
    }

    @media (prefers-reduced-motion: reduce) {
        .reel {
            animation: none;
        }
    }
</style>

<script>
const films = document.querySelectorAll<HTMLElement>("[data-hero-film]");
const seen = new WeakSet<HTMLElement>();

function arm(film: HTMLElement) {
	if (seen.has(film)) return;
	seen.add(film);

	const reduced =
		window.matchMedia &&
		window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const reels = Array.from(
		film.querySelectorAll<HTMLVideoElement>(".reel"),
	);

	if (reduced) {
		reels.forEach((reel) => {
			reel.removeAttribute("loop");
			reel.pause();
		});
		return;
	}

	let inView = true;

	const playAll = () => {
		if (!inView || document.hidden) return;
		reels.forEach((reel) => reel.play().catch(() => {}));
	};

	const stopAll = () => {
		reels.forEach((reel) => reel.pause());
	};

	const io = new IntersectionObserver((entries) => {
		for (const entry of entries) {
			inView = entry.isIntersecting;
			if (inView) playAll();
			else stopAll();
		}
	});
	io.observe(film);

	document.addEventListener("visibilitychange", () => {
		if (document.hidden) stopAll();
		else playAll();
	});

	playAll();
}

function boot() {
	films.forEach(arm);
}

boot();
if (window.swup?.hooks) {
	window.swup.hooks.on("page:view", () => setTimeout(boot, 60));
} else {
	document.addEventListener("swup:enable", () => {
		window.swup?.hooks?.on("page:view", () => setTimeout(boot, 60));
	});
}
</script>
