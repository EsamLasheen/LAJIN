---
import { Icon } from "astro-icon/components";
---

<button id="signal-audio-toggle" class="signal-audio-toggle" type="button" aria-label="Toggle signal audio" aria-pressed="false">
    <Icon name="material-symbols:graphic-eq-rounded" class="signal-audio-icon" />
    <span class="signal-audio-label">Signal</span>
</button>

<script is:inline>
(() => {
    const button = document.getElementById("signal-audio-toggle");
    if (!button) return;
    const label = button.querySelector(".signal-audio-label");

    let ctx;
    let master;
    let filter;
    let compressor;
    let graphConnected = false;
    let timer;
    let playing = false;
    let audioUnlocked = false;
    let autoplayAttempted = false;
    let step = 0;

    const pattern = [
        [130.81, 164.81, 196],
        [146.83, 174.61, 220],
        [164.81, 196, 246.94],
        [174.61, 220, 261.63],
        [164.81, 196, 246.94],
        [146.83, 174.61, 220],
        [130.81, 164.81, 196],
        [174.61, 220, 293.66],
    ];

    const setLabel = (text) => {
        if (label) label.textContent = text;
    };

    const updateState = (isPlaying, blocked = false) => {
        playing = isPlaying;
        button.classList.toggle("is-playing", isPlaying);
        button.classList.toggle("autoplay-blocked", blocked);
        button.setAttribute("aria-pressed", isPlaying ? "true" : "false");
        setLabel(blocked ? "Click for signal" : isPlaying ? "Signal on" : "Signal");
    };

    const ensureGraph = async () => {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) {
            throw new Error("Web Audio is not supported.");
        }

        ctx = ctx || new AudioContext();
        if (ctx.state === "suspended") {
            await ctx.resume();
        }
        if (ctx.state !== "running") {
            throw new Error(`AudioContext is ${ctx.state}.`);
        }

        if (!compressor) {
            compressor = ctx.createDynamicsCompressor();
            compressor.threshold.setValueAtTime(-28, ctx.currentTime);
            compressor.knee.setValueAtTime(22, ctx.currentTime);
            compressor.ratio.setValueAtTime(8, ctx.currentTime);
            compressor.attack.setValueAtTime(0.01, ctx.currentTime);
            compressor.release.setValueAtTime(0.18, ctx.currentTime);
        }

        if (!filter) {
            filter = ctx.createBiquadFilter();
            filter.type = "lowpass";
            filter.frequency.setValueAtTime(1400, ctx.currentTime);
            filter.Q.setValueAtTime(0.5, ctx.currentTime);
        }

        if (!master) {
            master = ctx.createGain();
            master.gain.setValueAtTime(0.48, ctx.currentTime);
        }

        if (!graphConnected) {
            master.connect(filter);
            filter.connect(compressor);
            compressor.connect(ctx.destination);
            graphConnected = true;
        }
        audioUnlocked = true;
    };

    const playTone = (frequency, duration, gainValue, type = "triangle", detune = 0) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(frequency, ctx.currentTime);
        osc.detune.setValueAtTime(detune, ctx.currentTime);
        gain.gain.setValueAtTime(0.0001, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(gainValue, ctx.currentTime + 0.04);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(master);
        osc.start();
        osc.stop(ctx.currentTime + duration + 0.05);
    };

    const pulse = () => {
        const chord = pattern[step % pattern.length];
        chord.forEach((note, index) => {
            playTone(note, index === 0 ? 0.46 : 0.30, index === 0 ? 0.18 : 0.085, index === 2 ? "sawtooth" : "triangle", index === 2 ? 4 : -3);
        });

        if (step % 4 === 0) {
            playTone(chord[0] / 2, 0.9, 0.12, "sine");
        }

        if (step % 8 === 6) {
            playTone(chord[2] * 2, 0.18, 0.08, "square", 8);
        }

        step += 1;
    };

    const start = async () => {
        if (playing) return;
        window.clearInterval(timer);
        await ensureGraph();
        step = 0;
        pulse();
        timer = window.setInterval(pulse, 520);
        updateState(true, false);
    };

    const stop = () => {
        window.clearInterval(timer);
        timer = undefined;
        updateState(false, false);
    };

    button.addEventListener("click", async () => {
        if (playing) {
            stop();
            return;
        }
        try {
            await start();
        } catch (_error) {
            updateState(false, true);
        }
    });

    const tryAutoplay = async () => {
        if (autoplayAttempted || playing) return;
        autoplayAttempted = true;
        try {
            await start();
        } catch (_error) {
            updateState(false, true);
        }
    };

    const unlockOnGesture = async (event) => {
        if (event.target instanceof Element && event.target.closest("#signal-audio-toggle")) {
            return;
        }
        if (audioUnlocked || playing) {
            return;
        }
        try {
            await start();
            window.removeEventListener("pointerdown", unlockOnGesture);
            window.removeEventListener("keydown", unlockOnGesture);
            window.removeEventListener("touchstart", unlockOnGesture);
        } catch (_error) {
            updateState(false, true);
        }
    };

    window.addEventListener("pointerdown", unlockOnGesture, { passive: true });
    window.addEventListener("keydown", unlockOnGesture);
    window.addEventListener("touchstart", unlockOnGesture, { passive: true });

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", tryAutoplay, { once: true });
    } else {
        tryAutoplay();
    }
})();
</script>
