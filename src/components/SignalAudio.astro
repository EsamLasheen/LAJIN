---
import { Icon } from "astro-icon/components";
---

<button id="signal-audio-toggle" class="signal-audio-toggle" type="button" aria-label="Toggle signal audio" aria-pressed="false">
    <Icon name="material-symbols:graphic-eq-rounded" class="signal-audio-icon" />
    <span class="signal-audio-label">Signal</span>
</button>

<script is:inline>
(() => {
    const button = document.getElementById("signal-audio-toggle");
    if (!button) return;
    const label = button.querySelector(".signal-audio-label");

    let ctx;
    let master;
    let timer;
    let playing = false;
    let masterConnected = false;
    let step = 0;
    let autoplayAttempted = false;
    const notes = [130.81, 174.61, 196, 261.63, 293.66, 261.63, 196, 174.61];

    const startNode = (frequency, duration, gainValue, type = "sine") => {
        const oscillator = ctx.createOscillator();
        const gain = ctx.createGain();
        oscillator.type = type;
        oscillator.frequency.setValueAtTime(frequency, ctx.currentTime);
        gain.gain.setValueAtTime(0, ctx.currentTime);
        gain.gain.linearRampToValueAtTime(gainValue, ctx.currentTime + 0.025);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
        oscillator.connect(gain);
        gain.connect(master);
        oscillator.start();
        oscillator.stop(ctx.currentTime + duration + 0.03);
    };

    const tick = () => {
        const note = notes[step % notes.length];
        startNode(note, 0.46, 0.12, "triangle");
        startNode(note * 1.5, 0.26, 0.045, "sine");
        if (step % 4 === 0) startNode(note / 2, 1.05, 0.08, "sine");
        if (step % 8 === 6) startNode(note * 2, 0.18, 0.055, "square");
        step += 1;
    };

    const markStopped = () => {
        playing = false;
        button.classList.remove("is-playing");
        button.setAttribute("aria-pressed", "false");
        if (label) label.textContent = button.classList.contains("autoplay-blocked") ? "Click for signal" : "Signal";
    };

    const ensureAudio = async () => {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) {
            throw new Error("Web Audio is not supported in this browser.");
        }

        ctx = ctx || new AudioContext();
        if (ctx.state === "suspended") {
            await ctx.resume();
        }

        if (ctx.state !== "running") {
            throw new Error(`AudioContext is ${ctx.state}.`);
        }

        master = master || ctx.createGain();
        master.gain.setValueAtTime(0.32, ctx.currentTime);
        if (!masterConnected) {
            master.connect(ctx.destination);
            masterConnected = true;
        }
    };

    const start = async () => {
        if (playing) return;
        window.clearInterval(timer);
        await ensureAudio();

        step = 0;
        tick();
        timer = window.setInterval(tick, 520);
        playing = true;
        button.classList.remove("autoplay-blocked");
        button.classList.add("is-playing");
        button.setAttribute("aria-pressed", "true");
        if (label) label.textContent = "Signal on";
    };

    const stop = () => {
        window.clearInterval(timer);
        timer = undefined;
        markStopped();
    };

    button.addEventListener("click", async () => {
        if (playing) {
            stop();
            return;
        }
        try {
            await start();
        } catch (_error) {
            button.classList.add("autoplay-blocked");
            if (label) label.textContent = "Click for signal";
            markStopped();
        }
    });

    const tryAutoplay = async () => {
        if (autoplayAttempted || playing) return;
        autoplayAttempted = true;
        try {
            await start();
        } catch (_error) {
            button.classList.add("autoplay-blocked");
            if (label) label.textContent = "Click for signal";
            markStopped();
        }
    };

    const startAfterGesture = async (event) => {
        if (event.target instanceof Element && event.target.closest("#signal-audio-toggle")) {
            return;
        }
        try {
            if (!playing) {
                await start();
            }
            window.removeEventListener("pointerdown", startAfterGesture);
            window.removeEventListener("keydown", startAfterGesture);
            window.removeEventListener("touchstart", startAfterGesture);
        } catch (_error) {
            button.classList.add("autoplay-blocked");
            if (label) label.textContent = "Click for signal";
            markStopped();
        }
    };

    window.addEventListener("pointerdown", startAfterGesture, { once: true, passive: true });
    window.addEventListener("keydown", startAfterGesture, { once: true });
    window.addEventListener("touchstart", startAfterGesture, { once: true, passive: true });

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", tryAutoplay, { once: true });
    } else {
        tryAutoplay();
    }
})();
</script>
