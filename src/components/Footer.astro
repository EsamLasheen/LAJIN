---

import { profileConfig } from "../config";
import { url } from "../utils/url-utils";
import OutroBand from "./OutroBand.astro";

const currentYear = new Date().getFullYear();
---

<OutroBand></OutroBand>
<footer class="site-footer">
    <div class="site-footer-rule" aria-hidden="true"></div>
    <div class="site-footer-mark" aria-hidden="true"></div>
    <div class="transition text-50 text-sm text-center site-footer-line">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved.
        <span class="mx-1">/</span>
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS</a> /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a>
    </div>
</footer>

<style>
    .site-footer {
        position: relative;
        margin: 4rem auto 3rem;
        max-width: 42rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0 1.5rem;
    }

    .site-footer-rule {
        width: 100%;
        height: 1px;
        background: linear-gradient(90deg, transparent, oklch(0.5 0 0 / 0.35), transparent);
        margin-bottom: 1.15rem;
    }

    .site-footer-mark {
        width: 0.55rem;
        height: 0.55rem;
        transform: rotate(45deg);
        border: 1px solid oklch(0.5 0 0 / 0.45);
        background: var(--page-bg);
        margin: -1.05rem 0 1.05rem;
    }
</style>
