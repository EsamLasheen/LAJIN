<script>
// Gentle 3D tilt on cards — desktop pointers only.
const fine =
	window.matchMedia("(pointer: fine)").matches &&
	!window.matchMedia("(prefers-reduced-motion: reduce)").matches;

function isTiltTarget(card: Element): boolean {
	return !card.closest(
		"#navbar, #top-row, #navbar-wrapper, #sidebar, .lajin-shell, .welcome-gate, #boot-intro, .float-panel",
	);
}

if (fine) {
	let current: HTMLElement | null = null;

	const reset = (card: HTMLElement) => {
		card.style.transform = "";
		card.style.transition = "transform 260ms ease";
		window.setTimeout(() => {
			if (card.style.transform === "") card.style.transition = "";
		}, 300);
	};

	document.addEventListener("pointermove", (event) => {
		if (current && !document.contains(current)) {
			current = null;
		}
		const target = event.target instanceof Element ? event.target.closest(".card-base") : null;
		const card = target && isTiltTarget(target) ? (target as HTMLElement) : null;

		if (card !== current) {
			if (current) reset(current);
			current = card;
			if (current) current.style.transition = "transform 120ms ease-out";
		}

		if (!current) return;

		const rect = current.getBoundingClientRect();
		if (
			event.clientY < rect.top ||
			event.clientY > rect.bottom ||
			event.clientX < rect.left ||
			event.clientX > rect.right
		) {
			reset(current);
			current = null;
			return;
		}

		const dx = (event.clientX - rect.left) / rect.width - 0.5;
		const dy = (event.clientY - rect.top) / rect.height - 0.5;
		current.style.transform = `perspective(1000px) rotateX(${(-dy * 3).toFixed(2)}deg) rotateY(${(dx * 3).toFixed(2)}deg)`;
	}, { passive: true });

	document.addEventListener("pointerleave", () => {
		if (current) {
			reset(current);
			current = null;
		}
	});
}
</script>
